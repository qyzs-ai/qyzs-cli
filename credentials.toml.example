# qyzs 多 API Key 凭据文件样本。
# 部署时复制到 $XDG_CONFIG_HOME/qyzs/credentials.toml；未设置 XDG_CONFIG_HOME 时，
# Linux/macOS 默认使用 ~/.config/qyzs/credentials.toml。

# 首个 Key；旧版本只读取此字段，必须保留。
api_key = "replace-with-primary-key"

# 其余 Key；qyzs 会将 api_key 与本列表合并后按请求轮询。
api_keys = [
  "replace-with-secondary-key",
  "replace-with-third-key",
]
